# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
COLLECTION_NAME=tech_docs

# Embedding 模型配置
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Ollama LLM 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# 文档处理参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=4

# 幻觉抑制参数
# 相似度阈值：低于此阈值的文档片段不会传给 LLM（0.0-1.0）
# 阈值越高，越严格（越容易说"我不知道"）
RELEVANCE_THRESHOLD=0.4

# 多轮对话记忆配置
# 记住最近多少轮对话（1轮=1次用户提问+1次AI回答）
# 设置为0或负数则关闭记忆功能
MEMORY_TURNS=3
