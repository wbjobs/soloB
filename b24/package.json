{
  "name": "smith-waterman-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "wasm": "wasm-pack build --target bundler --out-dir pkg",
    "wasm:web": "wasm-pack build --target web --out-dir pkg",
    "dev": "vite dev",
    "build": "npm run wasm && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "smith_waterman_wasm": "file:./pkg"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "type": "module"
}
